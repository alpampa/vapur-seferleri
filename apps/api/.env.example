NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# SQLite veritabanı dosyası (API verisi). Üretimde kalıcı bir volume yoluna verin.
DATABASE_URL="file:./dev.db"

# Demo modu: true iken harici AIS/tarife sağlayıcısı olmadan mock provider çalışır.
ENABLE_DEMO_MODE="true"

# JWT sırları — üretimde MUTLAKA değiştirin (openssl rand -hex 32)
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Seed ile oluşturulacak ilk admin (üretimde değiştirin)
SEED_ADMIN_EMAIL="admin@vapur.app"
SEED_ADMIN_PASSWORD="ChangeMe123!"
