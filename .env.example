# ==========================================
# VAPUR (FERRYFLOW) ENVIRONMENT CONFIGURATION
# ==========================================

# [FRONTEND / WEB]  — Next.js uygulaması
# İstemci tarafında kullanılan backend adresleri
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
# Mapbox token (opsiyonel; yoksa offline grid/leaflet fallback kullanılır)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# [BACKEND / API]  — NestJS servisi
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Demo modu: harici AIS/tarife sağlayıcısı olmadan mock provider çalışır
ENABLE_DEMO_MODE="true"

# JWT sırları — üretimde MUTLAKA değiştirin (openssl rand -hex 32)
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# [DATABASE]
# API tek bir SQLite dosyası kullanır (bkz. apps/api/prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# [SEED]
SEED_ADMIN_EMAIL="admin@vapur.app"
SEED_ADMIN_PASSWORD="ChangeMe123!"
