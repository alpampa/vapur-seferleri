# ==========================================
# FERRYFLOW ENVIRONMENT CONFIGURATION
# ==========================================

# [FRONTEND]
# The public URL of the backend API
NEXT_PUBLIC_API_URL="http://localhost:3001"
# The public URL of the backend WebSocket
NEXT_PUBLIC_WS_URL="http://localhost:3001"
# Mapbox Token for Live Map (Optional, fallback grid used if missing)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# [BACKEND]
# Node Environment (development, production)
NODE_ENV="development"
# Port for the NestJS API
PORT=3001
# URL of the frontend (for CORS)
FRONTEND_URL="http://localhost:3000"
# JWT Secret for Authentication
JWT_SECRET="your_super_secret_jwt_key_here"

# [DATABASE]
# PostgreSQL connection string
DATABASE_URL="postgresql://ferryflow:password@localhost:5432/ferryflow"
# Redis connection string
REDIS_HOST="localhost"
REDIS_PORT=6379
